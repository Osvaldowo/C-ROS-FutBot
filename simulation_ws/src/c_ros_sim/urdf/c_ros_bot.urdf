<?xml version="1.0"?>
<robot name="c_ros_bot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- PARÁMETROS DINÁMICOS                       -->
  <!-- ========================================== -->
  <!-- prefix: Se usa para separar los tópicos y TFs de cada robot (ej: 'futbot_1/') -->
  <xacro:arg name="prefix" default=""/>

  <!-- ========================================== -->
  <!-- MATERIALES Y COLORES                       -->
  <!-- ========================================== -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="red"><color rgba="0.8 0 0 1"/></material>

  <!-- ========================================== -->
  <!-- ESLABONES (LINKS) Y ARTICULACIONES (JOINTS)-->
  <!-- ========================================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <!-- Asegúrate de que esta ruta sea correcta -->
        <mesh filename="package://c_ros_sim/meshes/Futbot3.0.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/> 
      <geometry>
        <box size="0.25 0.15 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- RUEDA IZQUIERDA -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.005 0.069 0.012" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RUEDA DERECHA -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.005 -0.069 0.012" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RUEDA LOCA (CASTER) 1 -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </visual>
    <collision><geometry><sphere radius="0.015"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.065 0 -0.007" rpy="0 0 0"/>
  </joint>

  <!-- RUEDA LOCA (CASTER) 2 -->
  <link name="caster_wheel2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </visual>
    <collision><geometry><sphere radius="0.015"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="caster_wheel2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel2"/>
    <origin xyz="0.065 0 -0.007" rpy="0 0 0"/>
  </joint>

  <!-- CÁMARA -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry><box size="0.02 0.06 0.04"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.01"/> <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.075 0 0.125" rpy="0 0.3490 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- NUEVO SENSOR: LIDAR                        -->
  <!-- ========================================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Colocado arriba del chasis -->
    <origin xyz="0.0 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- REFERENCIAS DE MATERIAL Y FRICCIÓN (GAZEBO)-->
  <!-- ========================================== -->
  <gazebo reference="caster_wheel">
    <mu>0.0</mu><mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="caster_wheel2">
    <mu>0.0</mu><mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="camera_link">
    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
  </gazebo>
  <gazebo reference="left_wheel">
    <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
  </gazebo>
  <gazebo reference="right_wheel">
    <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
  </gazebo>
  <gazebo reference="lidar_link">
    <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material>
  </gazebo>

  <!-- ========================================== -->
  <!-- PLUGINS DE SENSORES Y CONTROL              -->
  <!-- ========================================== -->

  <!-- CÁMARA -->
  <gazebo reference="camera_link"> 
    <sensor type="camera" name="futbot_camera">
      <pose>0 0 0 0 0 0</pose> 
      <always_on>true</always_on>
      <visualize>true</visualize> 
      <update_rate>30.0</update_rate> 
      
      <topic>$(arg prefix)camera/image_raw</topic>
      
      <camera name="head">
        <horizontal_fov>1.1944</horizontal_fov> 
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.02</near><far>10.0</far></clip>
        <distortion>
          <k1>-0.421</k1><k2>0.185</k2><k3>0.0</k3><p1>0.0</p1><p2>0.0</p2><center>0.5303 0.3875</center>
        </distortion>
      </camera>
    </sensor>
  </gazebo>

  <!-- LIDAR -->
<!-- LIDAR -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      
      <topic>$(arg prefix)scan</topic>
      
      <!-- NUEVO: Le decimos a Gazebo el frame exacto para el mensaje de RViz -->
      <gz_frame_id>$(arg prefix)lidar_link</gz_frame_id>
      
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <!-- Visión de 360 grados -->
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- CONTROL DIFERENCIAL -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.138</wheel_separation>
      <wheel_radius>0.034</wheel_radius>
      <max_linear_velocity>0.88</max_linear_velocity>
      <max_angular_velocity>10.6</max_angular_velocity>
      
      <topic>$(arg prefix)cmd_vel</topic>
      <odom_topic>$(arg prefix)odom</odom_topic>
      <frame_id>$(arg prefix)odom</frame_id>
      <child_frame_id>$(arg prefix)base_footprint</child_frame_id>
    </plugin>
  </gazebo>

</robot>